# ── Copy this to .env and fill in real values ─────────────────
# Never commit the filled-in .env.

# ── Runtime ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (SQLite for local dev) ───────────────────────────
DATABASE_URL=./data/app.db

# ── Auth ──────────────────────────────────────────────────────
# Generate with: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=
SESSION_TTL_DAYS=7

# ── Object storage (S3-compatible: Cloudflare R2 / Backblaze B2 / MinIO) ──
# Optional in local dev — uploads are disabled when these are empty.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for reading objects back (CDN or bucket domain)
S3_PUBLIC_URL=

# ── Client / Admin origins (CORS + cookie scope) ──────────────
CLIENT_ORIGIN=http://localhost:4321
ADMIN_ORIGIN=http://localhost:4322
