---
/**
 * Legacy section placeholders and the footer stay in one Astro component.
 * Markup comes from scripts/rk/sections.ts, the single source of truth.
 */
import {
  menuMarkup,
  burgersMarkup,
  chickenMarkup,
  combosMarkup,
  visitMarkup,
  footerMarkup,
} from '../../scripts/rk/sections';

const html = [
  menuMarkup(),
  burgersMarkup(),
  chickenMarkup(),
  combosMarkup(),
  visitMarkup(),
].join('\n');
const foot = footerMarkup();
---

<Fragment set:html={html} />
<Fragment set:html={foot} />
