---
/**
 * /menu — the full printed menu.
 *
 * A single viewer with a thumbnail rail and a lightbox, rather than seven huge
 * stacked images: the pages are 1055x1491, so stacking them would make the page
 * ~10000px tall and unreadable on a phone.
 *
 * All seven <img> tags are in the DOM (so next/prev is instant and the browser
 * can cache), but only the first is eager; the rest are lazy and only the active
 * one is visible.
 */
import RubyBase from '../layouts/RubyBase.astro';
import RubyNav from '../components/rk/RubyNav.astro';
import RubyFooter from '../components/rk/RubyFooter.astro';
import { content } from '../content/en';

const { fullMenu, brand } = content;
const pages = fullMenu.pages;
---

<RubyBase
  title={`Full Menu — ${brand.name}`}
  description={fullMenu.page.intro}
>
  <RubyNav />

  <main class="rkm" id="main" data-rkm>
    <header class="rkm__head">
      <div class="rk-wrap">
        <a class="rkm__crumb" href="/">← {fullMenu.page.back}</a>
        <h1 class="rkm__title rk-display">{fullMenu.page.title}</h1>
        <p class="rkm__intro">{fullMenu.page.intro}</p>
        <p class="rkm__hint">{fullMenu.page.hint}</p>
      </div>
    </header>

    <div class="rkm__body">
      <div class="rk-wrap">
        <!-- Active page -->
        <div
          class="rkm__stage"
          data-rkm-stage
          role="button"
          tabindex="0"
          aria-label="Enlarge this menu page"
        >
          <img
            src={pages[0].src}
            alt={pages[0].alt}
            width="1055"
            height="1491"
            data-rkm-img
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <!-- Controls -->
        <div class="rkm__bar">
          <button class="rkm__nav" type="button" data-rkm-prev aria-label="Previous page">← Prev</button>

          <span class="rkm__counter">
            <span data-rkm-count>01 / 07</span>
            <span class="rkm__page-title" data-rkm-title>{pages[0].title}</span>
          </span>

          <button class="rkm__nav" type="button" data-rkm-next aria-label="Next page">Next →</button>
        </div>

        <!-- Thumbnail rail -->
        <div class="rkm__thumbs" data-rkm-thumbs aria-label="Menu pages">
          {
            pages.map((p, i) => (
              <button
                class="rkm__thumb"
                type="button"
                data-rkm-thumb={i}
                aria-current={i === 0 ? 'true' : 'false'}
                aria-label={`${p.title} — page ${i + 1}`}
              >
                <img src={p.src} alt="" width="1055" height="1491" loading="lazy" decoding="async" />
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Lightbox -->
    <div class="rkm-lb" data-rkm-lb aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menu page viewer">
      <div class="rkm-lb__top">
        <span class="rkm-lb__label" data-rkm-lb-label>{pages[0].n} · {pages[0].title}</span>
        <button class="rkm-lb__close" type="button" data-rkm-lb-close aria-label="Close viewer">✕</button>
      </div>

      <div class="rkm-lb__stage">
        <button class="rkm-lb__arrow rkm-lb__arrow--prev" type="button" data-rkm-lb-prev aria-label="Previous page">←</button>
        <img class="rkm-lb__img" src={pages[0].src} alt={pages[0].alt} data-rkm-lb-img width="1055" height="1491" />
        <button class="rkm-lb__arrow rkm-lb__arrow--next" type="button" data-rkm-lb-next aria-label="Next page">→</button>
      </div>

      <p class="rkm-lb__foot">{fullMenu.page.hint}</p>
    </div>
  </main>

  <RubyFooter />
</RubyBase>

<script>
  import { initMenuPage } from '../scripts/rk/menu-page';
  const dispose = initMenuPage();
  document.addEventListener('pagehide', () => dispose(), { once: true });
</script>
