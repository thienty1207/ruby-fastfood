---
/**
 * Ruby Kitchen 81 homepage.
 *
 * Scope per client direction: hero + footer only. The menu / burgers / chicken
 * / combos / visit sections were removed — the diner sells in person and those
 * blocks were placeholder-heavy without photography or full menu data.
 *
 * The un-rebranded CRAV page remains at /clone for comparison.
 */
import RubyBase from '../layouts/RubyBase.astro';
import RubyNav from '../components/rk/RubyNav.astro';
import RubyHero from '../components/rk/RubyHero.astro';
import RubyFooter from '../components/rk/RubyFooter.astro';
---

<RubyBase>
  <RubyNav />
  <main class="rk-main" id="main">
    <RubyHero />
  </main>
  <RubyFooter />
</RubyBase>
