---
/**
 * Ruby Kitchen 81 homepage.
 *
 * Order: nav → hero → signature showcase (#menu) → full menu flipbook → journey
 * (the crab route) → footer.
 *
 * The flipbook sits ABOVE the journey deliberately: the crab travels through the
 * guest photos and is the page's closing spectacle, so the menu book hands off to
 * it rather than interrupting it.
 *
 * The un-rebranded CRAV page remains at /clone for comparison.
 */
import RubyBase from '../layouts/RubyBase.astro';
import RubyNav from '../components/rk/RubyNav.astro';
import RubyHero from '../components/rk/RubyHero.astro';
import RubySignature from '../components/rk/RubySignature.astro';
import RubyJourney from '../components/rk/RubyJourney.astro';
import RubyFullMenu from '../components/rk/RubyFullMenu.astro';
import RubyFooter from '../components/rk/RubyFooter.astro';
---

<RubyBase>
  <RubyNav />
  <main class="rk-main" id="main">
    <RubyHero />
    <RubySignature />
    <RubyFullMenu />
    <RubyJourney />
  </main>
  <RubyFooter />
</RubyBase>
