{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["astro/client"],
    "paths": {
      "@scripts/*": ["./src/scripts/*"],
      "@components/*": ["./src/components/*"],
      "@styles/*": ["./src/styles/*"],
      "@lib/*": ["./src/lib/*"],
      "@ruby/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.astro", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules"]
}
