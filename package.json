{
  "name": "ruby-fastfood",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ruby Fastfood — monorepo (Astro client/admin + Hono/Bun API)",
  "workspaces": [
    "frontend/client",
    "frontend/admin",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "bun run --filter '@ruby/client' dev",
    "dev:client": "bun run --filter '@ruby/client' dev",
    "dev:admin": "bun run --filter '@ruby/admin' dev",
    "dev:api": "bun run --filter '@ruby/backend' dev",
    "dev:all": "bun run --parallel --filter '@ruby/*' dev",
    "build": "bun run --filter '@ruby/client' build && bun run --filter '@ruby/admin' build",
    "build:client": "bun run --filter '@ruby/client' build",
    "build:admin": "bun run --filter '@ruby/admin' build",
    "typecheck": "bun run --filter '@ruby/*' typecheck",
    "db:migrate": "bun run --filter '@ruby/backend' db:migrate",
    "db:seed": "bun run --filter '@ruby/backend' db:seed",
    "audit": "bun audit",
    "qa:stable": "bun run tools/qa/stable.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
