{
  "name": "ruby-fastfood",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ruby Fastfood — monorepo (Astro client/admin + Hono/Bun API)",
  "workspaces": [
    "frontend/client",
    "frontend/admin",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "bun run --workspaces --if-present dev",
    "dev:client": "bun run --cwd frontend/client dev",
    "dev:admin": "bun run --cwd frontend/admin dev",
    "dev:api": "bun run --cwd backend dev",
    "build": "bun run --cwd frontend/client build && bun run --cwd frontend/admin build",
    "build:client": "bun run --cwd frontend/client build",
    "build:admin": "bun run --cwd frontend/admin build",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "db:migrate": "bun run --cwd backend db:migrate",
    "db:seed": "bun run --cwd backend db:seed",
    "audit": "bun audit",
    "qa:stable": "bun run tools/qa/stable.mjs",
    "push": "bun run tools/push.ts"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
